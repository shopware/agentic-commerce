<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <!-- Mock-based suite, runs on the lightweight fast-path bootstrap. -->
        <testsuite name="integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <!-- Functional tests: boot a real test kernel (booting bootstrap: SHOPWARE_PROJECT_DIR
             unset + APP_ENV=test) and drive UCP runtime routes through a real Symfony browser.
             Kept separate from the mock integration suite, which fails under a booted kernel. -->
        <testsuite name="functional">
            <directory>tests/Functional</directory>
        </testsuite>
    </testsuites>
    <php>
        <ini name="date.timezone" value="UTC"/>
        <env name="SWAG_AGENTIC_COMMERCE_SHOPWARE_BOOTSTRAP" value="1"/>
        <!-- The functional suite runs on the lane's platform phpunit, which ships the Symfony
             PHPUnit bridge. Its deprecation helper otherwise fails the run on direct
             deprecations emitted by Shopware's own TestBootstrapper (notably on 6.5/Symfony 6.4),
             even when every test passes. Disable it as Shopware's own phpunit config does.
             No-op for the unit/mock suites (plugin .tools phpunit ships no bridge). -->
        <env name="SYMFONY_DEPRECATIONS_HELPER" value="disabled"/>
    </php>
</phpunit>
