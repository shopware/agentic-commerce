includes:
__SHOPWARE_PHPSTAN_INCLUDES__
    # Pre-existing errors inherited from code merged from main (codex/backpart-agentic-files).
    # These are not introduced by this PR; remove once the original author fixes them.
    - phpstan-baseline.neon

parameters:
    level: 7
    reportUnmatchedIgnoredErrors: false
    paths:
        - src
        - tests
    tmpDir: __PHPSTAN_TMP_DIR__
    excludePaths:
        - src/Resources/app
        - src/Resources/public (?)
    bootstrapFiles:
        - tests/bootstrap.php
    ignoreErrors:
        -
            identifier: shopware.namespace
        -
            identifier: shopware.missingPackageAttribute
        -
            identifier: shopware.domainException
        # addFlags is deprecated in trunk (v6.8.0 return-type-change only); cross-version code must keep using it.
        -
            identifier: method.deprecated
            path: src/Content/ProductExport/Tracking
        # MigrationStep::addColumn() is trunk-only; migrations run on 6.5/6.6 too.
        -
            identifier: shopware.addColumn
        # CoversClass on unit tests in subdirs — rule incorrectly rejects sub-paths under tests/Unit/.
        -
            identifier: shopware.unexpectedTestCovers
        # DBAL fetchAllKeyValue() declares array<int|string, mixed>; the actual keys/values are strings.
        -
            identifier: return.type
            path: src/Migration/Migration1773329152AddAgenticCommerceSalesChannelType.php
        # In SW 6.6, Error::getErrorMessages() declares array<string, mixed>; our list<ErrorMessage> is
        # a valid subtype at runtime but PHPStan's key-type variance rejects it across versions.
        -
            identifier: method.childReturnType
            path: src/Content/ProductExport/Error
        # StaticEntityRepository generic type mismatch on $customerRepository parameter; the @var
        # assertion is placed before ??= to prevent CS Fixer converting /** to /*, which means
        # PHPStan infers a union type at the constructor call site in 6.6.x.
        -
            message: '#Variable \$customerRepository on left side of \?\?= always exists#'
            path: tests/Unit/Content/ProductExport/Tracking/SalesChannelTrackingListenerTest.php
        -
            identifier: argument.type
            path: tests/Unit/Content/ProductExport/Tracking/SalesChannelTrackingListenerTest.php
