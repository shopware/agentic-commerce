{
  "name": "swag-agentic-commerce-qa",
  "private": true,
  "type": "module",
  "scripts": {
    "ci:admin-static": "npm run lint:admin && npm run test:admin",
    "lint:admin": "eslint src/Resources/app/administration/src tests/jest/administration --cache --cache-location .eslintcache",
    "lint:admin:fix": "npm run lint:admin -- --fix",
    "lint:md": "prettier --check '**/*.md'",
    "lint:md:fix": "prettier --write '**/*.md'",
    "test:admin": "jest --config tests/jest/administration/jest.config.js --ci",
    "test:admin:watch": "jest --config tests/jest/administration/jest.config.js --watch",
    "acceptance": "npm --prefix tests/acceptance test",
    "acceptance:all": "npm --prefix tests/acceptance run test:all",
    "acceptance:known-blocked": "npm --prefix tests/acceptance run test:known-blocked",
    "acceptance:install": "npm --prefix tests/acceptance install",
    "acceptance:lint": "npm --prefix tests/acceptance run lint",
    "acceptance:typecheck": "npm --prefix tests/acceptance run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-junit": "^17.0.0",
    "prettier": "^3.9.8",
    "typescript-eslint": "^8.72.1"
  }
}
