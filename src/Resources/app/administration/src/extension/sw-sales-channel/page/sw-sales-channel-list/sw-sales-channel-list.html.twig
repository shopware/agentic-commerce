<!-- eslint-disable vue/valid-v-slot -->
{% block sw_sales_channel_list_grid_column_name %}
<template #column-name="{ item }">
    <sw-icon
        v-if="item.type && item.type.iconName === 'regular-sparkle'"
        name="regular-sparkle"
        size="18px"
    />
    <sw-icon
        v-else
        :name="item.type.iconName"
        size="18px"
    />
    <router-link
        :to="{
            name: 'sw.sales.channel.detail',
            params: { id: item.id }
        }"
    >{{ item.translated.name || item.name }}</router-link>
</template>
{% endblock %}

{% block sw_sales_channel_list_grid_column_status %}
{% parent %}
<template #column-ucpActive="{ item }">
    <sw-status v-if="ucpActiveMap[item.id]" color="green">
        {{ $t('swagAgenticCommerce.salesChannelList.ucpExposed') }}
    </sw-status>
    <sw-status v-else color="gray">
        {{ $t('swagAgenticCommerce.salesChannelList.ucpOff') }}
    </sw-status>
</template>
{% endblock %}

{# Sits in sw-card's default slot, which mt-card renders above the #grid slot,
   so the hint reads as part of the card instead of floating above it. #}
{% block sw_sales_channel_list_grid %}
<div
    v-if="showUcpOnboardingHint"
    class="sw-sales-channel-list__ucp-onboarding"
>
    <span class="sw-sales-channel-list__ucp-onboarding-text">
        {{ $t('swagAgenticCommerce.onboarding.hintNothingExposed') }}
    </span>
    <router-link
        class="sw-sales-channel-list__ucp-onboarding-link"
        :to="{ name: 'sw.settings.agentic.commerce.index' }"
    >{{ $t('swagAgenticCommerce.onboarding.reopenAction') }}</router-link>
</div>

{% parent %}
{% endblock %}

