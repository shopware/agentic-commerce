{% block sw_settings_ucp_index %}
<sw-page class="sw-settings-ucp-index">
    <template #smart-bar-header>
        <h2>{{ $t('sw-settings-ucp.general.mainMenuItemGeneral') }}</h2>
    </template>

    <template #content>
        <sw-card-view>
            <sw-card class="sw-settings-ucp-index__intro" :isLoading="isLoading">
                <div class="sw-settings-ucp-index__intro-shell">
                    <div>
                        <p class="sw-settings-ucp-index__eyebrow">{{ $t('sw-settings-ucp.general.overviewTitle') }}</p>
                        <h3 class="sw-settings-ucp-index__intro-title">{{ $t('sw-settings-ucp.general.mainMenuItemGeneral') }}</h3>
                        <p class="sw-settings-ucp-index__intro-description">{{ $t('sw-settings-ucp.general.overviewDescription') }}</p>
                    </div>

                    <div class="sw-settings-ucp-index__intro-metrics">
                        <div class="sw-settings-ucp-index__intro-metric">
                            <span class="sw-settings-ucp-index__metric-label">{{ $t('sw-settings-ucp.general.shopwareVersion') }}</span>
                            <span class="sw-settings-ucp-index__metric-value">{{ formattedShopwareVersion }}</span>
                        </div>
                        <div class="sw-settings-ucp-index__intro-metric">
                            <span class="sw-settings-ucp-index__metric-label">{{ $t('sw-settings-ucp.general.salesChannelsTitle') }}</span>
                            <span class="sw-settings-ucp-index__metric-value">{{ salesChannels.length }}</span>
                        </div>
                        <div class="sw-settings-ucp-index__intro-metric">
                            <span class="sw-settings-ucp-index__metric-label">{{ $t('sw-settings-ucp.general.activeSalesChannelsTitle') }}</span>
                            <span class="sw-settings-ucp-index__metric-value">{{ activeSalesChannels.length }}</span>
                        </div>
                        <div class="sw-settings-ucp-index__intro-metric">
                            <span class="sw-settings-ucp-index__metric-label">{{ $t('sw-settings-ucp.general.inactiveSalesChannelsTitle') }}</span>
                            <span class="sw-settings-ucp-index__metric-value">{{ inactiveSalesChannels.length }}</span>
                        </div>
                    </div>
                </div>

            </sw-card>

            <div v-if="salesChannels.length === 0" class="sw-settings-ucp-index__empty">
                <sw-empty-state
                    :title="$t('sw-settings-ucp.general.salesChannelsTitle')"
                    :subline="$t('sw-settings-ucp.general.noSalesChannelsMessage')"
                    icon="regular-globe-stand" />
            </div>

            <template v-else>
                <sw-card
                    class="sw-settings-ucp-index__active-section"
                    :title="$t('sw-settings-ucp.general.activeSalesChannelsTitle')"
                    :isLoading="isLoading">
                    <p class="sw-settings-ucp-index__section-copy">
                        {{ $t('sw-settings-ucp.general.activeSalesChannelsDescription') }}
                    </p>

                    <div v-if="!hasActiveSalesChannels" class="sw-settings-ucp-index__quiet-empty">
                        {{ $t('sw-settings-ucp.general.noActiveSalesChannelsMessage') }}
                    </div>

                    <div v-else class="sw-settings-ucp-index__channel-grid">
                        <div
                            v-for="salesChannel in activeSalesChannels"
                            :key="salesChannel.id"
                            class="sw-settings-ucp-index__sales-channel">
                            <div class="sw-settings-ucp-index__channel-header">
                                <div>
                                    <p class="sw-settings-ucp-index__eyebrow">{{ $t('sw-settings-ucp.general.salesChannelLabel') }}</p>
                                    <h3 class="sw-settings-ucp-index__channel-title">{{ salesChannel.name }}</h3>
                                </div>

                                <span
                                    :class="['sw-settings-ucp-index__status-pill', statusClass(salesChannel)]">
                                    {{ statusLabel(salesChannel) }}
                                </span>
                            </div>

                            <div class="sw-settings-ucp-index__metric-grid">
                                <div class="sw-settings-ucp-index__metric-card">
                                    <span class="sw-settings-ucp-index__metric-label">{{ $t('sw-settings-ucp.general.capabilityCountLabel') }}</span>
                                    <span class="sw-settings-ucp-index__metric-value">{{ capabilityCount(salesChannel) }}</span>
                                </div>
                                <div class="sw-settings-ucp-index__metric-card">
                                    <span class="sw-settings-ucp-index__metric-label">{{ $t('sw-settings-ucp.general.transportSummaryLabel') }}</span>
                                    <span class="sw-settings-ucp-index__metric-value">{{ transportSummary(salesChannel) }}</span>
                                </div>
                            </div>

                            <div class="sw-settings-ucp-index__actions">
                                <sw-button
                                    size="small"
                                    variant="primary"
                                    :router-link="ucpDetailRoute(salesChannel)">
                                    {{ $t('sw-settings-ucp.general.openUcpConfigurationButton') }}
                                </sw-button>
                                <sw-button
                                    size="small"
                                    :router-link="salesChannelRoute(salesChannel)">
                                    {{ $t('sw-settings-ucp.general.openSalesChannelButton') }}
                                </sw-button>
                            </div>
                        </div>
                    </div>
                </sw-card>

                <sw-card
                    v-if="hasInactiveSalesChannels"
                    class="sw-settings-ucp-index__inactive-section"
                    :title="$t('sw-settings-ucp.general.inactiveSalesChannelsTitle')"
                    :isLoading="isLoading">
                    <p class="sw-settings-ucp-index__section-copy">
                        {{ $t('sw-settings-ucp.general.inactiveSalesChannelsDescription') }}
                    </p>

                    <div class="sw-settings-ucp-index__inactive-list">
                        <div
                            v-for="salesChannel in inactiveSalesChannels"
                            :key="salesChannel.id"
                            class="sw-settings-ucp-index__inactive-row">
                            <div class="sw-settings-ucp-index__inactive-copy">
                                <span class="sw-settings-ucp-index__inactive-name">{{ salesChannel.name }}</span>
                                <span class="sw-settings-ucp-index__inactive-domain">{{ salesChannel.domains && salesChannel.domains[0] ? salesChannel.domains[0].url : $t('sw-settings-ucp.general.noDomainLabel') }}</span>
                            </div>

                            <div class="sw-settings-ucp-index__inactive-actions">
                                <sw-button-process
                                    size="small"
                                    variant="primary"
                                    :isLoading="isActivatingSalesChannel(salesChannel)"
                                    :disabled="!canEditConfig"
                                    @click="activateSalesChannel(salesChannel)">
                                    {{ $t('sw-settings-ucp.general.activateSalesChannelButton') }}
                                </sw-button-process>
                            </div>
                        </div>
                    </div>
                </sw-card>
            </template>
        </sw-card-view>
    </template>
</sw-page>
{% endblock %}
