{% block sw_settings_ucp_detail %}
<sw-page class="sw-settings-ucp-detail">
    <template #smart-bar-header>
        <h2>
            {{ $tc('sw-settings-ucp.general.detailTitle') }}
        </h2>
    </template>

    <template #smart-bar-actions>
        <sw-button-process
            v-if="canEditConfig"
            variant="primary"
            :isLoading="isSaving"
            @click="save">
            {{ $tc('sw-settings-ucp.general.saveButton') }}
        </sw-button-process>
    </template>

    <template #content>
        <sw-card-view>
            <sw-card class="sw-settings-ucp-detail__hero" :isLoading="isLoading">
                <div class="sw-settings-ucp-detail__hero-shell">
                    <div>
                        <p class="sw-settings-ucp-detail__eyebrow">{{ $tc('sw-settings-ucp.general.salesChannelLabel') }}</p>
                        <h3 class="sw-settings-ucp-detail__title">{{ salesChannel ? salesChannel.name : $tc('sw-settings-ucp.general.detailTitle') }}</h3>
                        <p class="sw-settings-ucp-detail__description">{{ $tc('sw-settings-ucp.general.detailDescription') }}</p>

                        <div class="sw-settings-ucp-detail__hero-alerts">
                            <sw-alert
                                v-if="showDiscoveryWarning"
                                variant="info"
                                :title="$tc('sw-settings-ucp.general.discoveryDisabledTitle')">
                                {{ $tc('sw-settings-ucp.general.discoveryDisabledMessage') }}
                            </sw-alert>

                            <sw-alert
                                v-if="showReadOnlyNotice"
                                variant="info"
                                :title="$tc('sw-settings-ucp.general.readOnlyTitle')">
                                {{ $tc('sw-settings-ucp.general.readOnlyMessage') }}
                            </sw-alert>
                        </div>
                    </div>

                    <div>
                        <div class="sw-settings-ucp-detail__summary-grid">
                            <div class="sw-settings-ucp-detail__summary-card">
                                <span class="sw-settings-ucp-detail__summary-label">{{ $tc('sw-settings-ucp.general.statusLabel') }}</span>
                                <span :class="['sw-settings-ucp-detail__status-pill', activeStatusClass]">{{ activeStatusLabel }}</span>
                            </div>
                            <div class="sw-settings-ucp-detail__summary-card">
                                <span class="sw-settings-ucp-detail__summary-label">{{ $tc('sw-settings-ucp.general.capabilityCountLabel') }}</span>
                                <span class="sw-settings-ucp-detail__summary-value">{{ enabledCapabilityCount }}</span>
                            </div>
                            <div class="sw-settings-ucp-detail__summary-card">
                                <span class="sw-settings-ucp-detail__summary-label">{{ $tc('sw-settings-ucp.general.transportSummaryLabel') }}</span>
                                <span class="sw-settings-ucp-detail__summary-value">{{ transportSummaryLabel }}</span>
                            </div>
                            <div class="sw-settings-ucp-detail__summary-card">
                                <span class="sw-settings-ucp-detail__summary-label">{{ $tc('sw-settings-ucp.general.domainsLabel') }}</span>
                                <span class="sw-settings-ucp-detail__summary-value sw-settings-ucp-detail__summary-value--domains">{{ domainUrls() }}</span>
                            </div>
                        </div>

                        <div class="sw-settings-ucp-detail__hero-actions" v-if="salesChannel">
                            <sw-button
                                size="small"
                                :router-link="salesChannelBaseRoute">
                                {{ $tc('sw-settings-ucp.general.openSalesChannelButton') }}
                            </sw-button>
                        </div>
                    </div>
                </div>
            </sw-card>

            <div class="sw-settings-ucp-detail__layout">
                <sw-card
                    class="sw-settings-ucp-detail__section"
                    :title="$tc('sw-settings-ucp.general.exposureCardTitle')"
                    :isLoading="isLoading">
                    <p class="sw-settings-ucp-detail__section-copy">{{ $tc('sw-settings-ucp.general.exposureCardDescription') }}</p>

                    <div class="sw-settings-ucp-detail__field-stack sw-settings-ucp-detail__form-grid">
                        <sw-switch-field
                            class="sw-settings-ucp-detail__form-full sw-settings-ucp-detail__form-switch"
                            :value="form.active"
                            :label="$tc('sw-settings-ucp.general.activeLabel')"
                            :disabled="!canEditConfig"
                            @update:value="form.active = $event" @change="setValue('active', $event)" />

                        <sw-single-select
                            :value="form.profileUriStrategy"
                            :label="$tc('sw-settings-ucp.general.profileUriStrategyLabel')"
                            :options="profileUriStrategyOptions"
                            labelProperty="label"
                            valueProperty="value"
                            :disabled="!canEditConfig"
                            @update:value="form.profileUriStrategy = $event" @change="setValue('profileUriStrategy', $event)" />

                        <sw-text-field
                            v-if="showCustomProfileUri"
                            :value="form.customProfileUri"
                            :label="$tc('sw-settings-ucp.general.customProfileUriLabel')"
                            :placeholder="$tc('sw-settings-ucp.general.customProfileUriPlaceholder')"
                            :disabled="!canEditConfig"
                            @update:value="form.customProfileUri = $event" @change="setValue('customProfileUri', $event)" />

                        <sw-text-field
                            class="sw-settings-ucp-detail__form-full"
                            :value="form.continueUrlTemplate"
                            :label="$tc('sw-settings-ucp.general.continueUrlTemplateLabel')"
                            :placeholder="$tc('sw-settings-ucp.general.continueUrlTemplatePlaceholder')"
                            :disabled="!canEditConfig"
                            @update:value="form.continueUrlTemplate = $event" @change="setValue('continueUrlTemplate', $event)" />
                    </div>
                </sw-card>

                <sw-card
                    class="sw-settings-ucp-detail__section"
                    :title="$tc('sw-settings-ucp.general.securityCardTitle')"
                    :isLoading="isLoading">
                    <div class="sw-settings-ucp-detail__field-stack sw-settings-ucp-detail__form-grid sw-settings-ucp-detail__security-grid">
                        <sw-alert
                            class="sw-settings-ucp-detail__security-full"
                            v-if="showSignaturePolicyWarning"
                            variant="warning"
                            :title="$tc('sw-settings-ucp.general.signaturePolicyWarningTitle')">
                            {{ $tc('sw-settings-ucp.general.signaturePolicyWarningMessage', 0, { policy: signaturePolicyLabelText }) }}
                        </sw-alert>

                        <sw-alert
                            class="sw-settings-ucp-detail__security-full"
                            v-if="showAllowlistWarning"
                            variant="info"
                            :title="$tc('sw-settings-ucp.general.allowlistWarningTitle')">
                            {{ $tc('sw-settings-ucp.general.allowlistWarningMessage') }}
                        </sw-alert>

                        <sw-single-select
                            :value="form.signaturePolicy"
                            :label="$tc('sw-settings-ucp.general.signaturePolicyLabel')"
                            :options="signaturePolicyOptions"
                            labelProperty="label"
                            valueProperty="value"
                            :disabled="!canEditConfig"
                            @update:value="form.signaturePolicy = $event" @change="setValue('signaturePolicy', $event)" />

                        <div class="sw-settings-ucp-detail__switch-inline">
                            <sw-switch-field
                                class="sw-settings-ucp-detail__form-switch"
                                :value="form.idempotencyRequired"
                                label=""
                                :aria-label="$tc('sw-settings-ucp.general.idempotencyRequiredLabel')"
                                :disabled="!canEditConfig"
                                @update:value="form.idempotencyRequired = $event" @change="setValue('idempotencyRequired', $event)" />

                            <span class="sw-settings-ucp-detail__switch-label">
                                {{ $tc('sw-settings-ucp.general.idempotencyRequiredLabel') }}
                            </span>

                            <sw-help-text
                                :text="$tc('sw-settings-ucp.general.idempotencyRequiredHelpText')" />
                        </div>

                        <sw-alert
                            class="sw-settings-ucp-detail__security-full"
                            v-if="showDeferredDiscoveryBudgetNotice"
                            variant="info"
                            :title="$tc('sw-settings-ucp.general.discoveryBudgetDeferredTitle')">
                            {{ $tc('sw-settings-ucp.general.discoveryBudgetDeferredMessage') }}
                        </sw-alert>

                        <sw-number-field
                            :value="form.discoveryBudget"
                            :label="$tc('sw-settings-ucp.general.discoveryBudgetLabel')"
                            :min="1"
                            disabled
                            @update:value="form.discoveryBudget = $event" @change="setValue('discoveryBudget', $event)" />

                        <sw-tagged-field
                            :value="form.remoteProfileAllowlist"
                            :label="$tc('sw-settings-ucp.general.remoteProfileAllowlistLabel')"
                            :placeholder="$tc('sw-settings-ucp.general.remoteProfileAllowlistPlaceholder')"
                            :disabled="!canEditConfig"
                            @update:value="setHostList('remoteProfileAllowlist', $event)" @change="setHostList('remoteProfileAllowlist', $event)" />

                        <sw-tagged-field
                            :value="form.agentAllowlist"
                            :label="$tc('sw-settings-ucp.general.agentAllowlistLabel')"
                            :placeholder="$tc('sw-settings-ucp.general.agentAllowlistPlaceholder')"
                            :disabled="!canEditConfig"
                            @update:value="setHostList('agentAllowlist', $event)" @change="setHostList('agentAllowlist', $event)" />

                        <sw-tagged-field
                            :value="form.embeddedAllowedOrigins"
                            :label="$tc('sw-settings-ucp.general.embeddedAllowedOriginsLabel')"
                            :placeholder="$tc('sw-settings-ucp.general.embeddedAllowedOriginsPlaceholder')"
                            :disabled="!canEditConfig"
                            @update:value="setHostList('embeddedAllowedOrigins', $event)" @change="setHostList('embeddedAllowedOrigins', $event)" />

                        <sw-tagged-field
                            :value="form.embeddedFrameAncestors"
                            :label="$tc('sw-settings-ucp.general.embeddedFrameAncestorsLabel')"
                            :placeholder="$tc('sw-settings-ucp.general.embeddedFrameAncestorsPlaceholder')"
                            :disabled="!canEditConfig"
                            @update:value="setHostList('embeddedFrameAncestors', $event)" @change="setHostList('embeddedFrameAncestors', $event)" />

                        <sw-text-field
                            :value="form.webhookUrlOverride"
                            :label="$tc('sw-settings-ucp.general.webhookUrlOverrideLabel')"
                            :placeholder="$tc('sw-settings-ucp.general.webhookUrlOverridePlaceholder')"
                            :disabled="!canEditConfig"
                            @update:value="form.webhookUrlOverride = $event" @change="setValue('webhookUrlOverride', $event)" />
                    </div>
                </sw-card>

                <sw-card
                    class="sw-settings-ucp-detail__section"
                    :title="$tc('sw-settings-ucp.general.capabilitiesCardTitle')"
                    :isLoading="isLoading">
                    <p class="sw-settings-ucp-detail__section-copy">{{ $tc('sw-settings-ucp.general.capabilitiesCardDescription') }}</p>

                    <div class="sw-settings-ucp-detail__checkbox-grid sw-settings-ucp-detail__checkbox-grid--capabilities">
                        <sw-checkbox-field
                            v-for="capability in capabilityOptions"
                            :key="capability.value"
                            :value="isCapabilityEnabled(capability.value)"
                            :label="$tc(capability.label)"
                            :disabled="!canEditConfig"
                            @update:value="updateCapability(capability.value, $event)" @change="updateCapability(capability.value, $event)" />
                    </div>
                </sw-card>

                <sw-card
                    class="sw-settings-ucp-detail__section"
                    :title="$tc('sw-settings-ucp.general.transportsCardTitle')"
                    :isLoading="isLoading">
                    <p class="sw-settings-ucp-detail__section-copy">{{ $tc('sw-settings-ucp.general.transportsCardDescription') }}</p>

                    <div class="sw-settings-ucp-detail__checkbox-grid sw-settings-ucp-detail__checkbox-grid--transports">
                        <sw-checkbox-field
                            v-for="transport in transportOptions"
                            :key="transport.value"
                            :value="isTransportEnabled(transport.value)"
                            :label="transport.label"
                            :helpText="transport.disabled ? transport.disabledReason : transport.description"
                            :disabled="!canEditConfig || transport.disabled"
                            @update:value="updateTransport(transport.value, $event)" @change="updateTransport(transport.value, $event)" />
                    </div>

                    <sw-alert
                        variant="info"
                        :title="$tc('sw-settings-ucp.general.pendingTransportsTitle')">
                        {{ $tc('sw-settings-ucp.general.pendingTransportsMessage') }}
                    </sw-alert>
                </sw-card>

                <sw-card
                    class="sw-settings-ucp-detail__section"
                    :title="$tc('sw-settings-ucp.general.keysCardTitle')"
                    :isLoading="isLoading || isKeyActionLoading">
                    <p class="sw-settings-ucp-detail__section-copy">{{ $tc('sw-settings-ucp.general.keysCardDescription') }}</p>

                    <div class="sw-settings-ucp-detail__key-create">
                        <sw-text-field
                            :value="newKeyKid"
                            :label="$tc('sw-settings-ucp.general.newKeyKidLabel')"
                            :placeholder="$tc('sw-settings-ucp.general.newKeyKidPlaceholder')"
                            :disabled="!canRotateKeys"
                            @update:value="newKeyKid = $event" @change="setKeyValue('newKeyKid', $event)" />

                        <sw-single-select
                            :value="newKeyAlgorithm"
                            :label="$tc('sw-settings-ucp.general.newKeyAlgorithmLabel')"
                            :options="keyAlgorithmOptions"
                            labelProperty="label"
                            valueProperty="value"
                            :disabled="!canRotateKeys"
                            @update:value="newKeyAlgorithm = $event" @change="setKeyValue('newKeyAlgorithm', $event)" />

                        <sw-button-process
                            class="sw-settings-ucp-detail__key-create-button"
                            variant="primary"
                            :isLoading="isKeyActionLoading"
                            :disabled="!canRotateKeys"
                            @click="createKey">
                            {{ $tc('sw-settings-ucp.general.createKeyButton') }}
                        </sw-button-process>
                    </div>

                    <div v-if="sortedKeys.length === 0" class="sw-settings-ucp-detail__empty-state">
                        {{ $tc('sw-settings-ucp.general.noKeysLabel') }}
                    </div>

                    <div v-else class="sw-settings-ucp-detail__keys">
                        <div
                            v-for="key in sortedKeys"
                            :key="key.kid"
                            class="sw-settings-ucp-detail__key-row">
                            <div class="sw-settings-ucp-detail__key-header">
                                <div>
                                    <h4 class="sw-settings-ucp-detail__key-title">{{ key.kid }}</h4>
                                    <p class="sw-settings-ucp-detail__key-algorithm">{{ key.algorithm }}</p>
                                </div>

                                <span :class="['sw-settings-ucp-detail__status-pill', key.status === 'active' ? 'is--active' : 'is--inactive']">
                                    {{ formatKeyStatus(key.status) }}
                                </span>
                            </div>

                            <div class="sw-settings-ucp-detail__key-meta">
                                <div class="sw-settings-ucp-detail__key-meta-item">
                                    <span class="sw-settings-ucp-detail__key-meta-label">{{ $tc('sw-settings-ucp.general.keyStatusLabel') }}</span>
                                    <span class="sw-settings-ucp-detail__key-meta-value">{{ formatKeyStatus(key.status) }}</span>
                                </div>

                                <div v-if="key.createdAt" class="sw-settings-ucp-detail__key-meta-item">
                                    <span class="sw-settings-ucp-detail__key-meta-label">{{ $tc('sw-settings-ucp.general.keyCreatedAtLabel') }}</span>
                                    <span class="sw-settings-ucp-detail__key-meta-value">{{ key.createdAt }}</span>
                                </div>

                                <div v-if="key.retireAt" class="sw-settings-ucp-detail__key-meta-item">
                                    <span class="sw-settings-ucp-detail__key-meta-label">{{ $tc('sw-settings-ucp.general.keyRetiredAtLabel') }}</span>
                                    <span class="sw-settings-ucp-detail__key-meta-value">{{ key.retireAt }}</span>
                                </div>
                            </div>

                            <div class="sw-settings-ucp-detail__key-actions">
                                <sw-button
                                    size="small"
                                    :disabled="!canRotateKeys"
                                    @click="retireKey(key.kid)">
                                    {{ $tc('sw-settings-ucp.general.retireKeyButton') }}
                                </sw-button>
                                <sw-button
                                    size="small"
                                    variant="danger"
                                    :disabled="!canRotateKeys"
                                    @click="deleteKey(key.kid)">
                                    {{ $tc('sw-settings-ucp.general.deleteKeyButton') }}
                                </sw-button>
                            </div>
                        </div>
                    </div>
                </sw-card>

                <sw-card
                    class="sw-settings-ucp-detail__preview-card"
                    :title="$tc('sw-settings-ucp.general.profilePreviewTitle')"
                    :isLoading="isLoading">
                    <div class="sw-settings-ucp-detail__preview-summary">
                        <div class="sw-settings-ucp-detail__preview-metric">
                            <span class="sw-settings-ucp-detail__preview-label">{{ $tc('sw-settings-ucp.general.profileSummaryCapabilities') }}</span>
                            <span class="sw-settings-ucp-detail__preview-value">{{ profileCapabilityNames.length }}</span>
                        </div>
                        <div class="sw-settings-ucp-detail__preview-metric">
                            <span class="sw-settings-ucp-detail__preview-label">{{ $tc('sw-settings-ucp.general.profileSummaryEndpoints') }}</span>
                            <span class="sw-settings-ucp-detail__preview-value">{{ serviceEndpointCount }}</span>
                        </div>
                    </div>

                    <pre v-if="preview" class="sw-settings-ucp-detail__preview-json">{{ profilePreviewJson }}</pre>
                </sw-card>
            </div>
        </sw-card-view>
    </template>
</sw-page>
{% endblock %}
