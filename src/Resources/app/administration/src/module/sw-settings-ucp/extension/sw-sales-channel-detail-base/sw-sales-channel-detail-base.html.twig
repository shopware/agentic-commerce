{% block sw_sales_channel_detail_base_options_api %}
    {% parent %}

    <sw-card
        v-if="salesChannel"
        class="sw-settings-ucp-sales-channel-shortcut"
        :title="$t('sw-settings-ucp.general.salesChannelShortcutTitle')"
    >
        <div class="sw-settings-ucp-sales-channel-shortcut__content">
            <div class="sw-settings-ucp-sales-channel-shortcut__copy">
                <p class="sw-settings-ucp-sales-channel-shortcut__eyebrow">
                    {{ $t('sw-settings-ucp.general.salesChannelShortcutEyebrow') }}
                </p>
                <p class="sw-settings-ucp-sales-channel-shortcut__description">
                    {{ $t('sw-settings-ucp.general.salesChannelShortcutDescription') }}
                </p>
            </div>

            <sw-button
                variant="primary"
                size="small"
                :router-link="{ name: 'sw.settings.ucp.detail', params: { salesChannelId: salesChannel.id } }"
            >
                {{ $t('sw-settings-ucp.general.openUcpConfigurationButton') }}
            </sw-button>
        </div>
    </sw-card>
{% endblock %}
