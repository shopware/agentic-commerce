<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults autowire="true" autoconfigure="true" public="false"/>

        <prototype namespace="Swag\AgenticCommerce\" resource="../../*" exclude="../../Resources"/>

        <service id="Swag\AgenticCommerce\Ucp\SalesChannel\SalesChannelViewProvider">
            <argument key="$salesChannelRepository" type="service" id="sales_channel.repository"/>
        </service>

        <service id="Swag\AgenticCommerce\Ucp\SalesChannel\SalesChannelDomainResolver">
            <argument key="$domainRepository" type="service" id="sales_channel_domain.repository"/>
        </service>

        <service id="Shopware\Core\System\SalesChannel\Context\SalesChannelContextServiceInterface" alias="Shopware\Core\System\SalesChannel\Context\SalesChannelContextService"/>
        <service id="Shopware\Core\Checkout\Cart\SalesChannel\AbstractCartLoadRoute" alias="Shopware\Core\Checkout\Cart\SalesChannel\CartLoadRoute"/>
        <service id="Shopware\Core\Checkout\Cart\SalesChannel\AbstractCartItemAddRoute" alias="Shopware\Core\Checkout\Cart\SalesChannel\CartItemAddRoute"/>
        <service id="Shopware\Core\Checkout\Cart\SalesChannel\AbstractCartItemUpdateRoute" alias="Shopware\Core\Checkout\Cart\SalesChannel\CartItemUpdateRoute"/>
        <service id="Shopware\Core\Checkout\Cart\SalesChannel\AbstractCartItemRemoveRoute" alias="Shopware\Core\Checkout\Cart\SalesChannel\CartItemRemoveRoute"/>
        <service id="Shopware\Core\Checkout\Cart\SalesChannel\AbstractCartDeleteRoute" alias="Shopware\Core\Checkout\Cart\SalesChannel\CartDeleteRoute"/>
        <service id="Shopware\Core\Checkout\Cart\SalesChannel\AbstractCartOrderRoute" alias="Shopware\Core\Checkout\Cart\SalesChannel\CartOrderRoute"/>
        <service id="Shopware\Core\Content\Product\SalesChannel\Search\AbstractProductSearchRoute" alias="Shopware\Core\Content\Product\SalesChannel\Search\ProductSearchRoute"/>
        <service id="Shopware\Core\Content\Product\SalesChannel\Detail\AbstractProductDetailRoute" alias="Shopware\Core\Content\Product\SalesChannel\Detail\ProductDetailRoute"/>

        <service id="Swag\AgenticCommerce\Ucp\Customer\GuestCustomerContextProvisioner">
            <argument key="$customerRepository" type="service" id="customer.repository"/>
            <argument key="$salutationRepository" type="service" id="salutation.repository"/>
        </service>

        <service id="Swag\AgenticCommerce\Ucp\Customer\GuestCustomerAddressResolver">
            <argument key="$countryRepository" type="service" id="country.repository"/>
        </service>

        <service id="Swag\AgenticCommerce\Ucp\Gateway\ShopwareOrderGateway">
            <argument key="$orderRepository" type="service" id="order.repository"/>
        </service>

        <service id="Swag\AgenticCommerce\Ucp\Command\SeedSmokeCatalogCommand">
            <argument key="$productRepository" type="service" id="product.repository"/>
            <argument key="$taxRepository" type="service" id="tax.repository"/>
            <argument key="$appEnv">%kernel.environment%</argument>
            <argument key="$smokeCatalogSeedEnabled">%env(bool:default:defaults_bool_false:SWAG_AGENTIC_COMMERCE_SMOKE_SEED)%</argument>
        </service>

        <service id="Swag\AgenticCommerce\Compatibility\ShopwareVersionDetector">
            <argument key="$kernelVersion">%kernel.shopware_version%</argument>
        </service>

        <service id="Swag\AgenticCommerce\AgenticDiscovery\DiscoveryBridgeInterface" alias="Swag\AgenticCommerce\AgenticDiscovery\TrunkDiscoveryBridge"/>
        <service id="Ucp\Sdk\Adapter\CatalogAdapterInterface" alias="Swag\AgenticCommerce\Ucp\Adapter\ShopwareCatalogAdapter"/>
        <service id="Ucp\Sdk\Adapter\CartAdapterInterface" alias="Swag\AgenticCommerce\Ucp\Adapter\ShopwareCartAdapter"/>
        <service id="Ucp\Sdk\Adapter\CheckoutAdapterInterface" alias="Swag\AgenticCommerce\Ucp\Adapter\ShopwareCheckoutAdapter"/>
        <service id="Ucp\Sdk\Adapter\DiscountAdapterInterface" alias="Swag\AgenticCommerce\Ucp\Adapter\ShopwareDiscountAdapter"/>
        <service id="Ucp\Sdk\Adapter\OrderAdapterInterface" alias="Swag\AgenticCommerce\Ucp\Adapter\ShopwareOrderAdapter"/>
        <service id="Ucp\Sdk\Contract\CatalogCapabilityInterface" alias="Swag\AgenticCommerce\Ucp\Capability\CatalogCapability"/>
        <service id="Ucp\Sdk\Contract\CartCapabilityInterface" alias="Swag\AgenticCommerce\Ucp\Capability\CartCapability"/>
        <service id="Ucp\Sdk\Contract\CheckoutCapabilityInterface" alias="Swag\AgenticCommerce\Ucp\Capability\CheckoutCapability"/>
        <service id="Ucp\Sdk\Contract\DiscountCapabilityInterface" alias="Swag\AgenticCommerce\Ucp\Capability\DiscountCapability"/>
        <service id="Ucp\Sdk\Contract\OrderCapabilityInterface" alias="Swag\AgenticCommerce\Ucp\Capability\OrderCapability"/>
        <service id="Ucp\Sdk\Contract\IdentityLinkingCapabilityInterface" alias="Swag\AgenticCommerce\Ucp\Capability\IdentityLinkingCapability"/>
        <service id="Ucp\Sdk\Contract\TokenizationCapabilityInterface" alias="Swag\AgenticCommerce\Ucp\Capability\PaymentTokenizationCapability"/>

        <service id="Swag\AgenticCommerce\Ucp\Capability\IdentityLinkingCapability">
            <argument key="$adapterIterable" type="tagged_iterator" tag="ucp_sdk.adapter.identity_linking"/>
        </service>

        <service id="Swag\AgenticCommerce\Ucp\Capability\UcpExtensionAvailability">
            <argument key="$identityLinkingAdapterIterable" type="tagged_iterator" tag="ucp_sdk.adapter.identity_linking"/>
        </service>

        <service id="Swag\AgenticCommerce\Ucp\Identity\ShopwareIdentityLinkingAdapter">
            <tag name="ucp_sdk.adapter.identity_linking"/>
        </service>

        <service id="Swag\AgenticCommerce\Ucp\Payment\ShopwareInvoicePaymentHandler">
            <tag name="ucp_sdk.payment_handler"/>
        </service>

        <service id="Swag\AgenticCommerce\Ucp\Admin\Api\UcpAdminController" public="true">
            <tag name="controller.service_arguments"/>
        </service>

        <service id="Swag\AgenticCommerce\Ucp\Test\WebhookCaptureStore">
            <argument key="$projectDir">%kernel.project_dir%</argument>
        </service>

        <service id="Swag\AgenticCommerce\Ucp\Test\Api\TestWebhookController" public="true">
            <argument key="$appEnv">%kernel.environment%</argument>
            <argument key="$debug">%kernel.debug%</argument>
            <argument key="$testCaptureEnabled">%env(bool:default:defaults_bool_false:SWAG_AGENTIC_COMMERCE_TEST_CAPTURE)%</argument>
            <tag name="controller.service_arguments"/>
        </service>

        <service id="Swag\AgenticCommerce\Ucp\Config\UcpConfigRepositoryInterface" alias="Swag\AgenticCommerce\Ucp\Config\DoctrineDbalUcpConfigRepository"/>
        <service id="Ucp\Sdk\Service\RuntimeConfigurationResolverInterface" alias="Swag\AgenticCommerce\Ucp\Config\ShopwareRuntimeConfigurationResolver"/>

        <service id="Swag\AgenticCommerce\Ucp\Mcp\Tool\UcpCatalogSearchTool">
            <tag name="shopware.store_api_mcp.tool"/>
        </service>

        <service id="Swag\AgenticCommerce\Ucp\Mcp\Tool\UcpCatalogLookupTool">
            <tag name="shopware.store_api_mcp.tool"/>
        </service>

        <service id="Swag\AgenticCommerce\Ucp\Mcp\Tool\UcpCartCreateTool">
            <tag name="shopware.store_api_mcp.tool"/>
        </service>

        <service id="Swag\AgenticCommerce\Ucp\Mcp\Tool\UcpCartGetTool">
            <tag name="shopware.store_api_mcp.tool"/>
        </service>

        <service id="Swag\AgenticCommerce\Ucp\Mcp\Tool\UcpCartUpdateTool">
            <tag name="shopware.store_api_mcp.tool"/>
        </service>

        <service id="Swag\AgenticCommerce\Ucp\Mcp\Tool\UcpCartCancelTool">
            <tag name="shopware.store_api_mcp.tool"/>
        </service>

        <service id="Swag\AgenticCommerce\Ucp\Mcp\Tool\UcpDiscountApplyTool">
            <tag name="shopware.store_api_mcp.tool"/>
        </service>

        <service id="Swag\AgenticCommerce\Ucp\Mcp\Tool\UcpCheckoutCreateTool">
            <tag name="shopware.store_api_mcp.tool"/>
        </service>

        <service id="Swag\AgenticCommerce\Ucp\Mcp\Tool\UcpCheckoutGetTool">
            <tag name="shopware.store_api_mcp.tool"/>
        </service>

        <service id="Swag\AgenticCommerce\Ucp\Mcp\Tool\UcpCheckoutUpdateTool">
            <tag name="shopware.store_api_mcp.tool"/>
        </service>

        <service id="Swag\AgenticCommerce\Ucp\Mcp\Tool\UcpCheckoutCompleteTool">
            <tag name="shopware.store_api_mcp.tool"/>
        </service>

        <service id="Swag\AgenticCommerce\Ucp\Mcp\Tool\UcpCheckoutCancelTool">
            <tag name="shopware.store_api_mcp.tool"/>
        </service>

        <service id="Swag\AgenticCommerce\Ucp\Mcp\Tool\UcpOrderGetTool">
            <tag name="shopware.store_api_mcp.tool"/>
        </service>

        <service id="Swag\AgenticCommerce\Ucp\Embedded\EmbeddedResponseListener">
            <tag name="kernel.event_listener" event="kernel.request" method="onKernelRequest"/>
            <tag name="kernel.event_listener" event="kernel.response" method="onKernelResponse" priority="-1024"/>
        </service>
    </services>
</container>
