{% block agentic_ai_catalog_json %}
    {% set host = {
        displayName: salesChannel.translated.name|default(salesChannel.name),
    } %}

    {% set entries = [] %}

    {% block agentic_ai_catalog_entries %}
        {# Keep this inline: Twig includes cannot mutate the caller's entries array, and this fallback owns JSON rendering. Keep in sync with the core override. #}
        {% if swag_agentic_commerce_ucp_active(salesChannel) and salesChannelFileContext.publisher|default(null) and salesChannelFileContext.baseUrl|default(null) %}
            {% set entries = entries|merge([{
                identifier: 'urn:air:' ~ salesChannelFileContext.publisher ~ ':resource:ucp-profile',
                displayName: 'Shopware UCP Profile',
                type: 'application/json',
                url: salesChannelFileContext.baseUrl ~ '/.well-known/ucp',
                description: 'Machine-readable Universal Commerce Protocol profile for enabled commerce capabilities on this sales channel.',
                tags: ['shopware', 'ucp', 'commerce'],
                representativeQueries: [
                    'inspect enabled UCP capabilities for this shop',
                    'use the UCP profile before performing commerce actions',
                ],
            }]) %}
        {% endif %}

        {{ {
            specVersion: '1.0',
            host: host,
            entries: entries,
        }|json_encode(constant('JSON_PRETTY_PRINT') + constant('JSON_UNESCAPED_SLASHES') + constant('JSON_UNESCAPED_UNICODE'))|raw }}
    {% endblock %}
{% endblock %}
