{
    "name": "shopware/agentic-commerce",
    "description": "Shopware plugin for agentic commerce discovery, product feeds, and Universal Commerce Protocol shopping flows",
    "version": "1.1.0",
    "type": "shopware-platform-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "shopware AG"
        }
    ],
    "require": {
        "php": "^8.1",
        "shopware/core": "~6.5.0 || ~6.6.0 || ~6.7.0",
        "ucp-php-sdk/symfony-bundle": "^0.0.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.88",
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^10.5",
        "rector/rector": "^1.1",
        "roave/backward-compatibility-check": "^8.6"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Swag\\AgenticCommerce\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Swag\\AgenticCommerce\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php bin/run.php phpunit --testsuite unit",
        "test:integration": "@php bin/run.php phpunit --testsuite integration",
        "test:functional": "@php bin/run.php phpunit --testsuite functional",
        "phpstan": "@php bin/run.php phpstan analyse --memory-limit=1G -c phpstan.neon",
        "cs": "@php bin/run.php php-cs-fixer fix --config=.php-cs-fixer.dist.php --using-cache=no --dry-run --diff",
        "cs-fix": "@php bin/run.php php-cs-fixer fix --config=.php-cs-fixer.dist.php --using-cache=no",
        "rector": "@php bin/run.php rector process --dry-run",
        "rector-fix": "@php bin/run.php rector process",
        "bc-check": "@php bin/run.php roave-backward-compatibility-check --from=HEAD^ --to=HEAD",
        "ci": [
            "@cs",
            "@phpstan",
            "@rector",
            "@test"
        ]
    },
    "extra": {
        "shopware-plugin-class": "Swag\\AgenticCommerce\\SwagAgenticCommerce",
        "label": {
            "de-DE": "Agentic Commerce",
            "en-GB": "Agentic Commerce"
        },
        "description": {
            "de-DE": "Erweitert Shopware um Agentic Commerce mit KI-Produktfeeds, Discovery-Dokumenten, Analysen und Einkaufsabläufen auf Basis des Universal Commerce Protocol für KI-Agenten.",
            "en-GB": "Adds Agentic Commerce capabilities to Shopware, including AI product feeds, merchant discovery documents, analytics, and Universal Commerce Protocol shopping flows for AI agents."
        },
        "manufacturerLink": {
            "de-DE": "https://store.shopware.com/shopware-ag.html",
            "en-GB": "https://store.shopware.com/en/shopware-ag.html"
        },
        "supportLink": {
            "de-DE": "https://issues.shopware.com/",
            "en-GB": "https://issues.shopware.com/"
        }
    },
    "suggest": {
        "shopware/storefront": "Enables storefront discovery documents and embedded commerce pages."
    },
    "config": {
        "sort-packages": true,
        "vendor-dir": ".tools/vendor",
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "symfony/runtime": true
        },
        "platform": {
            "php": "8.1.0"
        },
        "policy": {
            "advisories": {
                "ignore-id": [
                    "PKSA-cv56-2228-pzr6",
                    "PKSA-6r8f-nxsb-67bq",
                    "PKSA-gh7h-hhy4-byg7",
                    "PKSA-mwt3-h9tv-kx78",
                    "PKSA-hp6n-n4kz-21wk",
                    "PKSA-mckv-s5hg-868k"
                ]
            }
        }
    }
}
