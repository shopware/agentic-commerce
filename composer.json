{
    "name": "shopware/agentic-commerce",
    "description": "Shopware plugin for UCP and agentic commerce discovery",
    "type": "shopware-platform-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "shopware/core": ">=6.5.8.0 <7.0.0.0",
        "ucp-php-sdk/symfony-bundle": "^0.0.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.88",
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^10.5",
        "rector/rector": "^1.1",
        "roave/backward-compatibility-check": "^8.6"
    },
    "autoload": {
        "psr-4": {
            "Swag\\AgenticCommerce\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Swag\\AgenticCommerce\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php bin/run.php phpunit --testsuite unit",
        "test:integration": "@php bin/run.php phpunit --testsuite integration",
        "test:functional": "@php bin/run.php phpunit --testsuite functional",
        "phpstan": "@php bin/run.php phpstan analyse --memory-limit=1G -c phpstan.neon",
        "cs": "@php bin/run.php php-cs-fixer fix --config=.php-cs-fixer.dist.php --using-cache=no --dry-run --diff",
        "cs-fix": "@php bin/run.php php-cs-fixer fix --config=.php-cs-fixer.dist.php --using-cache=no",
        "rector": "@php bin/run.php rector process --dry-run",
        "rector-fix": "@php bin/run.php rector process",
        "bc-check": "@php bin/run.php roave-backward-compatibility-check --from=HEAD^ --to=HEAD",
        "ci": [
            "@cs",
            "@phpstan",
            "@rector",
            "@test"
        ]
    },
    "extra": {
        "shopware-plugin-class": "Swag\\AgenticCommerce\\SwagAgenticCommerce",
        "label": {
            "de-DE": "Agentic Commerce",
            "en-GB": "Agentic Commerce"
        },
        "description": {
            "de-DE": "UCP- und Agentic-Commerce-Plugin fuer Shopware",
            "en-GB": "UCP and agentic commerce plugin for Shopware"
        }
    },
    "suggest": {
        "shopware/core": "Provided by the active Shopware lane during plugin runtime and integration testing.",
        "shopware/storefront": "Provided by the active Shopware lane during plugin runtime and integration testing."
    },
    "config": {
        "sort-packages": true,
        "vendor-dir": ".tools/vendor",
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "symfony/runtime": true
        },
        "platform": {
            "php": "8.1.0"
        }
    }
}
